<?xml version="1.0" ?>
<!-- TEST-ONLY world for the live vertical-bypass acceptance runs (scenario G).
     Generated from the COMMITTED crazyflie_world.sdf - the version the saved
     maps in ros2_ws/map/ were built from - plus exactly one unmapped
     partial-height barrier.  The production world is NOT modified and is still
     the launch default; select this one with:
       ros2 launch cf_explore cf_auto.launch.py world:=<abs path to this file>
     Deliberately excludes the uncommitted full-height corridor wall, so the
     barrier below is the only object the saved maps do not know about. -->
<sdf version="1.8">
  <world name="demo">

    <!-- Core systems (Gazebo Harmonic) -->
    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"               name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>

    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Scene -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="ceiling">
      <static>true</static>
      <pose>0 0 2.5 0 0 0</pose>

      <link name="ceiling_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>75 75 0.05</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>75 75 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 0.15</ambient>
            <diffuse>0.8 0.8 0.8 0.15</diffuse>
            <specular>0.1 0.1 0.1 0.15</specular>
          </material>
          <transparency>0.7</transparency>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
    </model>

    <!-- CRTA_v4 building
         Place the mesh at:
           models/CRTA_v4/meshes/CRTA_mesh.dae -->
    <!-- Building spans 0–44.3 m in X and Y in mesh space.
         Offset by -22.15 in X and Y to centre it at world origin
         so the crazyflie spawns in the middle of the building. -->
    <model name="CRTA_v4">
      <static>true</static>
      <pose>-13.5 -5.5 0 0 0 0</pose>
      <link name="link_0">
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.166667</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.166667</iyy><iyz>0</iyz>
            <izz>0.166667</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://CRTA_v4/meshes/CRTA_mesh.dae</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <cast_shadows>true</cast_shadows>
        </visual>
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://CRTA_v4/meshes/CRTA_mesh.dae</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1</mu><mu2>1</mu2></ode>
            </friction>
            <contact>
              <ode>
                <kp>1e13</kp><kd>1</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
      </link>
    </model>

    wall = """
    <!-- Block the corridor toward the second large room.
         This closes the corridor at the physical location of the previous spawn area. -->
    <model name="corridor_block_wall">
      <static>true</static>
      <pose>0.0 5.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>30.0 0.2 2.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>30.0 0.2 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    """

    <!-- Crazyflie robot -->
    <include>
      <uri>model://crazyflie</uri>
      <name>crazyflie</name>
      <pose>0 0 0 0 0 0</pose>
    </include>


    <!-- ================================================================= -->
    <!-- TEST-ONLY unmapped obstacle for acceptance scenario G.            -->
    <!--                                                                   -->
    <!-- Partial-height barrier across the x = 11 corridor.  Present in NO  -->
    <!-- saved map, so cf_auto's layer-1 A* plans straight through it and   -->
    <!-- only the live rangers ever see it.                                -->
    <!--                                                                   -->
    <!-- Geometry chosen so the CURRENT safety policy has one unambiguous   -->
    <!-- solution.  No margin was relaxed to make it fit:                   -->
    <!--   top z = 0.60 m, floor to 0.60 m, 0.20 m thick, 25 m wide.        -->
    <!--   * layer-1 flight altitude is 0.50 m (base_footprint), so the      -->
    <!--     barrier top is 0.10 m ABOVE the airframe: it physically         -->
    <!--     blocks and cannot be overflown by accident.                     -->
    <!--   * it reaches the floor, so both downward probe candidates         -->
    <!--     (0.40 m and 0.30 m) are genuinely blocked as well.              -->
    <!--   * the horizontal ranger cone is 27 deg (13.5 deg half-angle), so  -->
    <!--     at the required 0.60 m forward clearance the beam reaches       -->
    <!--     0.60*tan(13.5deg) = 0.144 m below the sensor, which itself sits -->
    <!--     0.0374 m above base_footprint.  A candidate altitude z          -->
    <!--     therefore sees down to z - 0.107 m at that range:               -->
    <!--         z = 0.60 -> 0.493 m < 0.60 top  => detected, rejected       -->
    <!--         z = 0.70 -> 0.593 m < 0.60 top  => detected, rejected       -->
    <!--         z = 0.80 -> 0.693 m > 0.60 top  => CLEAR, accepted          -->
    <!--     so the accepted candidate is 0.80 m, leaving 0.20 m of real     -->
    <!--     physical clearance over the barrier.                            -->
    <!--   * climbing 0.50 -> 0.80 m needs 0.30 + 0.35 m headroom = 0.65 m;  -->
    <!--     the ceiling is at 2.50 m, so about 2.0 m is available.          -->
    <!--   * 25 m wide: the drone must cross OVER it, never round an edge.   -->
    <!-- ================================================================= -->
    <model name="bypass_test_partial_barrier">
      <static>true</static>
      <pose>11.0 0.0 0.30 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 25.0 0.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 25.0 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.35 0.15 1</ambient>
            <diffuse>0.85 0.35 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
