<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="demo">

    <!-- Core systems (Gazebo Harmonic) -->
    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"               name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>

    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Scene -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="ceiling">
      <static>true</static>
      <pose>0 0 2.5 0 0 0</pose>

      <link name="ceiling_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>75 75 0.05</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>75 75 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 0.15</ambient>
            <diffuse>0.8 0.8 0.8 0.15</diffuse>
            <specular>0.1 0.1 0.1 0.15</specular>
          </material>
          <transparency>0.7</transparency>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
    </model>

    <!-- CRTA_v4 building
         Place the mesh at:
           models/CRTA_v4/meshes/CRTA_mesh.dae -->
    <!-- Building spans 0–44.3 m in X and Y in mesh space.
         Offset by -22.15 in X and Y to centre it at world origin
         so the crazyflie spawns in the middle of the building. -->
    <model name="CRTA_v4">
      <static>true</static>
      <pose>-13.5 -5.5 0 0 0 0</pose>
      <link name="link_0">
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.166667</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.166667</iyy><iyz>0</iyz>
            <izz>0.166667</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://CRTA_v4/meshes/CRTA_mesh.dae</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <cast_shadows>true</cast_shadows>
        </visual>
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://CRTA_v4/meshes/CRTA_mesh.dae</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1</mu><mu2>1</mu2></ode>
            </friction>
            <contact>
              <ode>
                <kp>1e13</kp><kd>1</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
      </link>
    </model>

    wall = """
    <!-- Block the corridor toward the second large room.
         This closes the corridor at the physical location of the previous spawn area. -->
    <model name="corridor_block_wall">
      <static>true</static>
      <pose>0.0 5.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>30.0 0.2 2.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>30.0 0.2 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    """

    wall2 = """
    <!-- Block the corridor toward the second large room.
         This closes the corridor at the physical location of the previous spawn area. -->
    <model name="corridor_block_wall2">
      <static>true</static>
      <pose>11.0 0.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 25.0 2.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 25.0 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    """

    <!-- Crazyflie robot -->
    <include>
      <uri>model://crazyflie</uri>
      <name>crazyflie</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>
