    </model>


    <model name="pillar_6">
      <static>true</static>
      <pose>-2.7 2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1 0.3 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1 0.3 2.0</size></box>
          </geometry>
