<sdf version="1.8">
  <model name="crazyflie">
    <link name="crazyflie/body">
      <pose> 0 0 17.425E-3 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>16.571710E-06</ixx>
          <iyy>16.655602E-06</iyy>
          <izz>29.261652E-06</izz>
          <ixy>0.830806E-06</ixy>
          <ixz>0.718277E-06</ixz>
          <iyz>1.800197E-06</iyz>
        </inertia>
      </inertial>
      <collision name="crazyflie/body_collision">
        <geometry>
          <box>
            <size>0.10 0.10 34.850E-3</size>
          </box>
        </geometry>
      </collision>
      <visual name="crazyflie/body_visual">
        <geometry>
          <mesh>
            <uri>meshes/cf2_assembly.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <!--
        VL53L1x Multi-ranger deck — 6 individual sensors.
        Each sensor models one real VL53L1x with a 27° full-angle cone
        (half-angle ±13.5° = ±0.23562 rad).  The cone is implemented via
        5 vertical samples; the bridge reports the minimum range across all
        samples, matching real hardware behaviour (closest object in cone).

        Body-frame convention: X = forward, Y = left, Z = up.
        Sensor poses are expressed relative to crazyflie/body.
        The sensor's own X axis is the beam direction; "vertical" samples
        spread in the sensor's ZX plane, giving the ±13.5° cone.
      -->

      <!-- FRONT — beam along +X (no rotation) -->
      <sensor name='range_front' type='gpu_lidar'>
        <pose relative_to='crazyflie/body'>0 0 0.02 0 0 0</pose>
        <topic>range/front</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal><samples>7</samples><resolution>1</resolution>
              <min_angle>-0.23562</min_angle><max_angle>0.23562</max_angle></horizontal>
            <vertical><samples>7</samples><resolution>1</resolution>
              <min_angle>-0.23562</min_angle><max_angle>0.23562</max_angle></vertical>
          </scan>
          <range><min>0.03</min><max>4.0</max><resolution>0.001</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.008</stddev></noise>
        </ray>
        <always_on>1</always_on><visualize>true</visualize>
      </sensor>

      <!-- BACK — beam along -X (yaw 180°) -->
      <sensor name='range_back' type='gpu_lidar'>
        <pose relative_to='crazyflie/body'>0 0 0.02 0 0 3.14159265</pose>
        <topic>range/back</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal><samples>7</samples><resolution>1</resolution>
              <min_angle>-0.23562</min_angle><max_angle>0.23562</max_angle></horizontal>
            <vertical><samples>7</samples><resolution>1</resolution>
              <min_angle>-0.23562</min_angle><max_angle>0.23562</max_angle></vertical>
          </scan>
          <range><min>0.03</min><max>4.0</max><resolution>0.001</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.008</stddev></noise>
        </ray>
        <always_on>1</always_on><visualize>true</visualize>
      </sensor>

      <!-- LEFT — beam along +Y (yaw +90°) -->
      <sensor name='range_left' type='gpu_lidar'>
        <pose relative_to='crazyflie/body'>0 0 0.02 0 0 1.57079633</pose>
        <topic>range/left</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal><samples>7</samples><resolution>1</resolution>
              <min_angle>-0.23562</min_angle><max_angle>0.23562</max_angle></horizontal>
            <vertical><samples>7</samples><resolution>1</resolution>
              <min_angle>-0.23562</min_angle><max_angle>0.23562</max_angle></vertical>
          </scan>
          <range><min>0.03</min><max>4.0</max><resolution>0.001</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.008</stddev></noise>
        </ray>
        <always_on>1</always_on><visualize>true</visualize>
      </sensor>

      <!-- RIGHT — beam along -Y (yaw -90°) -->
      <sensor name='range_right' type='gpu_lidar'>
        <pose relative_to='crazyflie/body'>0 0 0.02 0 0 -1.57079633</pose>
        <topic>range/right</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal><samples>7</samples><resolution>1</resolution>
              <min_angle>-0.23562</min_angle><max_angle>0.23562</max_angle></horizontal>
            <vertical><samples>7</samples><resolution>1</resolution>
              <min_angle>-0.23562</min_angle><max_angle>0.23562</max_angle></vertical>
          </scan>
          <range><min>0.03</min><max>4.0</max><resolution>0.001</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.008</stddev></noise>
        </ray>
        <always_on>1</always_on><visualize>true</visualize>
      </sensor>

      <!-- UP — beam along +Z (pitch -90°) -->
      <sensor name='range_up' type='gpu_lidar'>
        <pose relative_to='crazyflie/body'>0 0 0.02 0 -1.57079633 0</pose>
        <topic>range/up</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal><samples>7</samples><resolution>1</resolution>
              <min_angle>-0.23562</min_angle><max_angle>0.23562</max_angle></horizontal>
            <vertical><samples>7</samples><resolution>1</resolution>
              <min_angle>-0.23562</min_angle><max_angle>0.23562</max_angle></vertical>
          </scan>
          <range><min>0.03</min><max>4.0</max><resolution>0.001</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.008</stddev></noise>
        </ray>
        <always_on>1</always_on><visualize>true</visualize>
      </sensor>

      <!-- DOWN — beam along -Z (pitch +90°), replaces Flow deck height estimate -->
      <sensor name='range_down' type='gpu_lidar'>
        <pose relative_to='crazyflie/body'>0 0 0.02 0 1.57079633 0</pose>
        <topic>range/down</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal><samples>7</samples><resolution>1</resolution>
              <min_angle>-0.23562</min_angle><max_angle>0.23562</max_angle></horizontal>
            <vertical><samples>7</samples><resolution>1</resolution>
              <min_angle>-0.23562</min_angle><max_angle>0.23562</max_angle></vertical>
          </scan>
          <range><min>0.03</min><max>4.0</max><resolution>0.001</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.008</stddev></noise>
        </ray>
        <always_on>1</always_on><visualize>true</visualize>
      </sensor>
    </link>
    <link name="crazyflie/m1_prop">
      <pose>0.031 -0.031 0.021 0 0 0</pose>
      <inertial>
        <mass>0.0008</mass>
        <inertia>
          <ixx>8.33333E-09</ixx>
          <iyy>1.08333E-07</iyy>
          <izz>1.13333E-07</izz>
        </inertia>
      </inertial>
      <visual name="crazyflie/m1_visual">
        <geometry>
          <mesh>
            <uri>meshes/ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <link name="crazyflie/m2_prop">
      <pose>-0.031 -0.031 0.021 0 0 0</pose>
      <inertial>
        <mass>0.0008</mass>
        <inertia>
          <ixx>8.33333E-09</ixx>
          <iyy>1.08333E-07</iyy>
          <izz>1.13333E-07</izz>
        </inertia>
      </inertial>
      <visual name="crazyflie/m2_visual">
        <geometry>
          <mesh>
            <uri>meshes/cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <link name="crazyflie/m3_prop">
      <pose>-0.031 0.031 0.021 0 0 0</pose>
      <inertial>
        <mass>0.0008</mass>
        <inertia>
          <ixx>8.33333E-09</ixx>
          <iyy>1.08333E-07</iyy>
          <izz>1.13333E-07</izz>
        </inertia>
      </inertial>
      <visual name="crazyflie/m3_visual">
        <geometry>
          <mesh>
            <uri>meshes/ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <link name="crazyflie/m4_prop">
      <pose>0.031 0.031 0.021 0 0 0</pose>
      <inertial>
        <mass>0.0008</mass>
        <inertia>
          <ixx>8.33333E-09</ixx>
          <iyy>1.08333E-07</iyy>
          <izz>1.13333E-07</izz>
        </inertia>
      </inertial>
      <visual name="crazyflie/m4_visual">
        <geometry>
          <mesh>
            <uri>meshes/cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="crazyflie/m1_joint" type="revolute">
      <child>crazyflie/m1_prop</child>
      <parent>crazyflie/body</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    <joint name="crazyflie/m2_joint" type="revolute">
      <child>crazyflie/m2_prop</child>
      <parent>crazyflie/body</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    <joint name="crazyflie/m3_joint" type="revolute">
      <child>crazyflie/m3_prop</child>
      <parent>crazyflie/body</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    <joint name="crazyflie/m4_joint" type="revolute">
      <child>crazyflie/m4_prop</child>
      <parent>crazyflie/body</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>crazyflie</robotNamespace>
      <jointName>crazyflie/m1_joint</jointName>
      <linkName>crazyflie/m1_prop</linkName>
      <turningDirection>ccw</turningDirection>
      <maxRotVelocity>2618</maxRotVelocity>
      <motorConstant>1.28192e-08</motorConstant>
      <momentConstant>0.005964552</momentConstant>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <actuator_number>0</actuator_number>
      <motorType>velocity</motorType>
    </plugin>
    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>crazyflie</robotNamespace>
      <jointName>crazyflie/m2_joint</jointName>
      <linkName>crazyflie/m2_prop</linkName>
      <turningDirection>cw</turningDirection>
      <maxRotVelocity>2618</maxRotVelocity>
      <motorConstant>1.28192e-08</motorConstant>
      <momentConstant>0.005964552</momentConstant>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <actuator_number>1</actuator_number>
      <motorType>velocity</motorType>
    </plugin>
    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>crazyflie</robotNamespace>
      <jointName>crazyflie/m3_joint</jointName>
      <linkName>crazyflie/m3_prop</linkName>
      <turningDirection>ccw</turningDirection>
      <maxRotVelocity>2618</maxRotVelocity>
      <motorConstant>1.28192e-08</motorConstant>
      <momentConstant>0.005964552</momentConstant>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <actuator_number>2</actuator_number>
      <motorType>velocity</motorType>
    </plugin>
    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>crazyflie</robotNamespace>
      <jointName>crazyflie/m4_joint</jointName>
      <linkName>crazyflie/m4_prop</linkName>
      <turningDirection>cw</turningDirection>
      <maxRotVelocity>2618</maxRotVelocity>
      <motorConstant>1.28192e-08</motorConstant>
      <momentConstant>0.005964552</momentConstant>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <actuator_number>3</actuator_number>
      <motorType>velocity</motorType>
    </plugin>
    <plugin
      filename="gz-sim-multicopter-control-system"
      name="gz::sim::systems::MulticopterVelocityControl">
      <robotNamespace>crazyflie</robotNamespace>
      <commandSubTopic>gazebo/command/twist</commandSubTopic>
      <enableSubTopic>enable</enableSubTopic>
      <comLinkName>crazyflie/body</comLinkName>
      <velocityGain>1.25 1.25 0.2425</velocityGain>
      <attitudeGain>0.02 0.02 0.02</attitudeGain>
      <angularRateGain>0.005 0.005 0.005</angularRateGain>
      <rotorConfiguration>
        <rotor>
          <jointName>crazyflie/m1_joint</jointName>
          <forceConstant>1.28192e-08</forceConstant>
          <momentConstant>0.005964552</momentConstant>
          <direction>1</direction>
        </rotor>
        <rotor>
          <jointName>crazyflie/m2_joint</jointName>
          <forceConstant>1.28192e-08</forceConstant>
          <momentConstant>0.005964552</momentConstant>
          <direction>-1</direction>
        </rotor>
        <rotor>
          <jointName>crazyflie/m3_joint</jointName>
          <forceConstant>1.28192e-08</forceConstant>
          <momentConstant>0.005964552</momentConstant>
          <direction>1</direction>
        </rotor>
        <rotor>
          <jointName>crazyflie/m4_joint</jointName>
          <forceConstant>1.28192e-08</forceConstant>
          <momentConstant>0.005964552</momentConstant>
          <direction>-1</direction>
        </rotor>
      </rotorConfiguration>
    </plugin>
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>